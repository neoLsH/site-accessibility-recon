{
  "version": 1,
  "notes": "shape.py 的判据表：只放通用文案，不绑定任何厂商。用 --signals 指向自己的表即可覆盖。",
  "challenge": [
    "captcha",
    "verify\\s+(?:that\\s+)?you\\s+are\\s+(?:a\\s+)?human",
    "checking\\s+your\\s+browser",
    "are\\s+you\\s+a\\s+robot",
    "unusual\\s+traffic",
    "enable\\s+javascript\\s+and\\s+cookies",
    "request\\s+(?:blocked|rejected)",
    "access\\s+denied",
    "安全验证",
    "人机验证",
    "滑动验证",
    "机器人验证",
    "验证码",
    "访问(?:受限|被拒)",
    "请求(?:过于|太)频繁",
    "请稍候"
  ],
  "login_path": [
    "/(?:login|signin|sign-in|auth|sso|passport)(?:/|$|\\?)"
  ],
  "login_phrase": [
    "扫码登录",
    "登录后(?:查看|继续)",
    "请(?:先)?登录",
    "sign\\s+in\\s+to\\s+continue",
    "log\\s+in\\s+to\\s+continue"
  ],
  "mounts": [
    "app",
    "root",
    "__next",
    "__nuxt",
    "__app",
    "mount"
  ],
  "csr_globals": [
    "__NEXT_DATA__",
    "__NUXT__",
    "__INITIAL_STATE__",
    "__APOLLO_STATE__",
    "__PRELOADED_STATE__"
  ]
}
